# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database (required — the server refuses to start without it)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecom
DB_USER=root
DB_PASSWORD=

# Auth (required)
JWT_SECRET=change-me-to-a-long-random-string-before-deploying

# Cloudinary (optional — avatars/categories fall back to local ./public when unset).
# Product images always save locally to <project root>/uploads/products/<category>/<productId>/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional — Gmail app password; email features disable cleanly when unset)
EMAIL_USER=
EMAIL_PASS=

# Stripe (optional — refunds fall back to ledger-only when unset)
STRIPE_SECRET_KEY=

# Admin seeder
ADMIN_NAME=GOBOXLY Admin
ADMIN_EMAIL=admin@goboxly.com
ADMIN_PASSWORD=Admin@1234
